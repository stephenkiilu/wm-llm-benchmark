# Only OPENAI_API_KEY is required. The numbered keys let parallel extraction
# runs use separate rate limits; select one with --key N.
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_KEY1=
OPENAI_API_KEY2=
OPENAI_API_KEY3=
OPENAI_API_KEY4=
OPENAI_API_KEY5=
OPENAI_API_KEY6=

# Both optional, used only by evaluation/publication_counts.py. NCBI asks
# callers to identify themselves; the key raises the PubMed rate limit from
# 3 to 10 requests/second. Neither is needed to reproduce the paper.
NCBI_EMAIL=
NCBI_API_KEY=
